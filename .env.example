# ─── GRE Complete — Environment Variables ─────────────────────────────────────
# Copy this file to .env.local for local development
# In Vercel: add these in Project Settings → Environment Variables

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → Project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Gemini API (optional server-side fallback) ─────────────────────────────────
# Users can also enter their own key in Settings
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
